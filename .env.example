# Server Configuration
PORT=3000

# Upstream proxy (needded in production)
# HTTP_PROXY=http://proxy.fi.uba.ar:8080
# NO_PROXY=localhost,127.0.0.1

# Target Servers Configuration
# Path to the JSON file containing target server mappings
TARGETS_CONFIG=targets.json

# Reboot-on-expiry Configuration (optional — only experiences with physical
# hardware need an entry here; see rebootTargets.json.example). The lab
# machine exposes a small endpoint (e.g. reboot.php) that checks this same
# secret before rebooting.
REBOOT_TARGETS_CONFIG=rebootTargets.json
REBOOT_SECRET=

# OAuth API Configuration
AUTHENTICATION_URL=https://laboratorios-remotos-test.fi.uba.ar

